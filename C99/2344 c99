#include <stdio.h>
int main(){
    int n;
    char r;
    scanf("%d",&n);
    if(n == 0){
        r = 'E';
    } else if(n >0 && n <=35){
        r = 'D';
    } else if(n>35 && n<=60){
        r = 'C';
    } else if(n>60 && n<=85){
        r = 'B';
    } else {
        r = 'A';
    }
    printf("%c\n",r);
}
