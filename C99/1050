#include <stdio.h>
#include <string.h>
int main(){
    char n[20];
    int d;
    scanf("%d", &d);
    if(d == 61){
        strcpy(n, "Brasilia");
    } else if (d == 71){
        strcpy(n, "Salvador");
    } else if(d == 11){
        strcpy(n, "Sao Paulo");
    } else if(d == 21){
        strcpy(n, "Rio de Janeiro");
    } else if(d == 32){
        strcpy(n, "Juiz de Fora");
    } else if(d == 19){
        strcpy(n, "Campinas");
    } else if(d == 27){
        strcpy(n, "Vitoria");
    } else if(d == 31){
        strcpy(n, "Belo Horizonte");
    } else {
        strcpy(n, "DDD nao cadastrado");
    }
    printf("%s\n",n);
}
